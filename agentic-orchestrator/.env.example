# API Keys for Agentic Orchestrator
# Copy this to .env and fill in your keys

# OpenRouter (free models)
OPENROUTER_API_KEY=your_openrouter_key_here

# NVIDIA NIM (free endpoints)
NVIDIA_API_KEY=your_nvidia_key_here

# Plan TokenRouter (MiniMax M3)
PLAN_TOKENROUTER_URL=your_plan_tokenrouter_endpoint
PLAN_TOKENROUTER_API_KEY=your_plan_tokenrouter_key_here

# MiMo v2.5
MIMO_API_URL=your_mimo_api_endpoint
MIMO_API_KEY=your_mimo_api_key_here
